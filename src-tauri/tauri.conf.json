{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Monitor Pet",
  "version": "0.2.4",
  "identifier": "com.knoka.stockpet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "股票监测宠物",
        "width": 320,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "url": "index.html",
        "backgroundColor": "#00000000",
        "shadow": false
      },
      {
        "label": "settings",
        "title": "股票监测宠物 - 设置",
        "width": 820,
        "height": 620,
        "minWidth": 620,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "focus": false,
        "visible": false,
        "closable": true,
        "url": "settings.html",
        "backgroundColor": "#070d14",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
